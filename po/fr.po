msgid "Set window border radius."
msgstr "Définir le rayon des coins de la fenêtre."

#: ui/appearance.ui:167
msgid "Border Color"
msgstr "Couleur de la bordure"

#: ui/appearance.ui:168
msgid "Select border color."
msgstr "Choisir la couleur de la bordure."

#: ui/appearance.ui:184
msgid "Window Effect"
msgstr "Effet de fenêtre"

