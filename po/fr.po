#: ui/appearance.ui:214
msgid "Animations"
msgstr "Animations"

#: ui/appearance.ui:215
msgid "Enable fade-in and fade-out animations."
msgstr "Activer les animations de fondu à l'ouverture et à la fermeture."

#: ui/appearance.ui:226
msgid "Animation Speed"
msgstr "Vitesse d'animation"

#: ui/appearance.ui:227
msgid "Set the animation speed. Lower is faster."
msgstr "Définir la vitesse d'animation. Une valeur basse est plus rapide."

#: ui/appearance.ui:247
msgid "Background"
msgstr "Arrière-plan"

#: ui/appearance.ui:251
msgid "Background Color"
msgstr "Couleur d'arrière-plan"

