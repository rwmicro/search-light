msgid "Set font size of search text and search result items."
msgstr "Définir la taille de police du texte de recherche et des résultats."

#: ui/appearance.ui:61
msgid "Search Text Size"
msgstr "Taille du texte de recherche"

#: ui/appearance.ui:62
msgid "Set font size for search input text."
msgstr "Définir la taille de police du champ de recherche."

#: ui/appearance.ui:74
msgid "Topbar Icon Color"
msgstr "Couleur de l'icône de la barre supérieure"

